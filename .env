# ── Local development (backend runs directly on host, NOT in Docker) ─────────
# When running uvicorn locally, localhost:11434 works fine.
# When running via docker compose on VPS, use host.docker.internal:11434 instead.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT=120
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","https://ai-chat-client-tau.vercel.app"]
DEBUG=false
