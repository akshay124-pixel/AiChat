# ─────────────────────────────────────────────────────────────────────────────
# backend/.env.example
#
# Copy to .env and fill in real values before running docker compose.
# NEVER commit the real .env file.
# ─────────────────────────────────────────────────────────────────────────────

# ── Ollama (running on VPS HOST, not inside Docker) ───────────────────────────
# "host.docker.internal" is resolved by Docker to the host machine's IP.
# This is set up by the extra_hosts entry in docker-compose.yml.
# Do NOT use http://localhost:11434 — inside the container, localhost is the
# container itself, not the host.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# The exact model name that is already pulled on the host Ollama.
# Check with: ollama list
OLLAMA_MODEL=qwen3:4b

# Seconds before an Ollama request times out. Raise for slow hardware.
OLLAMA_TIMEOUT=180

# ── CORS ─────────────────────────────────────────────────────────────────────
# JSON array of allowed frontend origins. Must include your exact Vercel URL.
# No trailing slash. Add preview URLs if needed.
# Example: ["https://your-app.vercel.app","https://your-domain.com"]
CORS_ORIGINS=["https://ai-chat-client-tau.vercel.app"]

# ── App ───────────────────────────────────────────────────────────────────────
# Set to true ONLY for local debugging — exposes /docs, /redoc, /openapi.json
DEBUG=false
